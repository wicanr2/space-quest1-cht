+// 繁體中文化：把 \n / \\ escape 還原成實際位元組（AGI 訊息含硬換行，塞不進單行 TSV）
+static Common::String chtUnescape(const Common::String &in) {
+	Common::String out;
+	for (uint i = 0; i < in.size(); i++) {
+		if (in[i] == '\\' && i + 1 < in.size()) {
+			char n = in[i + 1];
+			if (n == 'n') { out += '\n'; i++; continue; }
+			if (n == '\\') { out += '\\'; i++; continue; }
+			if (n == 't') { out += '\t'; i++; continue; }
+		}
+		out += in[i];
+	}
+	return out;
+}
+
+// 繁體中文化：載入 Big5 字型與 translation.tsv。須在 initVideo() 之前呼叫（initVideo 依 _chtEnabled 決定拉 hi-res）。
+void GfxMgr::loadChtResources() {
+	// 繁體中文化以「遊戲目錄有無 sq1_big5.fnt」為開關，不依賴 --language。
+	// 原因：SQ2 AGI 在 ScummVM 走 fallback 偵測，一旦把 target 語言設成非英文就無法啟動遊戲
+	//（任何非英文語言皆然，與中文無關）。改用字型檔存在與否，遊戲以英文正常啟動，中文照樣生效。
+	Common::File fontFile;
+	if (!fontFile.open("sq1_big5.fnt")) {
+		_chtEnabled = false;
+		return; // 沒有中文字型 → 維持英文
+	}
+	_chtEnabled = true;
+	_chtFont = new Graphics::Big5Font();
+	_chtFont->loadPrefixedRaw(fontFile, 16);
+	fontFile.close();
+	debug("AGI-CHT: Big5 字型 sq1_big5.fnt 已載入");
+
+	// translation.tsv：<english>\t<big5>，逐行載入成 HashMap
+	Common::File tsvFile;
+	if (tsvFile.open("translation.tsv")) {
+		while (!tsvFile.eos()) {
+			Common::String line = tsvFile.readLine();
+			if (line.empty())
+				continue;
+			uint32 tab = line.findFirstOf('\t');
+			if (tab == Common::String::npos)
+				continue;
+			Common::String key = chtUnescape(line.substr(0, tab));
+			Common::String val = chtUnescape(line.substr(tab + 1));
+			_chtTranslation[key] = val;
+		}
+		tsvFile.close();
+		debug("AGI-CHT: 載入 %d 則翻譯", (int)_chtTranslation.size());
+	} else {
+		warning("AGI-CHT: 找不到 translation.tsv");
+	}
+
+	loadChtTitleOverlay();
+}
+
+// 載入標題疊圖 sq1_title.ovl（格式見 tools/build_title_overlay.py）。缺檔則靜默略過。
+void GfxMgr::loadChtTitleOverlay() {
+	Common::File f;
+	if (!f.open("sq1_title.ovl"))
+		return;
+	byte magic[4];
+	f.read(magic, 4);
+	if (memcmp(magic, "CHTO", 4) != 0) {
+		warning("AGI-CHT: sq1_title.ovl magic 不符，略過");
+		return;
+	}
+	f.readByte();                 // version
+	f.readByte();                 // palType（EGA=0；AGI 端只用 EGA 索引）
+	_chtTitleOX = f.readUint16BE();
+	_chtTitleOY = f.readUint16BE();
+	_chtTitleOW = f.readUint16BE();
+	_chtTitleOH = f.readUint16BE();
+	uint32 n = (uint32)_chtTitleOW * _chtTitleOH;
+	_chtTitleOverlay = (byte *)malloc(n);
+	if (!_chtTitleOverlay) { _chtTitleOW = _chtTitleOH = 0; return; }
+	f.read(_chtTitleOverlay, n);
+	f.close();
+	debug("AGI-CHT: 標題疊圖已載入 (%dx%d @ %d,%d)", _chtTitleOW, _chtTitleOH, _chtTitleOX, _chtTitleOY);
+}
+
+// 若 picNr 是標題 pic（首張顯示的 pic），把「幻想空間」中文標題疊到 display 上。
+// 只在 hi-res(640x400) 顯示模式生效；索引 0xFF 為透明。
+void GfxMgr::drawChtTitleOverlay(int16 picNr) {
+	if (!_chtEnabled || !_chtTitleOverlay)
+		return;
+	if (_chtTitlePic == -1)
+		_chtTitlePic = picNr;     // 首張 pic 視為標題
+	if (picNr != _chtTitlePic)
+		return;
+	if (_displayScreenWidth < (int)(_chtTitleOX + _chtTitleOW) ||
+	    _displayScreenHeight < (int)(_chtTitleOY + _chtTitleOH))
+		return;                   // 非 hi-res / 尺寸不符時不疊，避免越界
+	for (uint16 ry = 0; ry < _chtTitleOH; ry++) {
+		byte *src = _chtTitleOverlay + ry * _chtTitleOW;
+		byte *dst = _displayScreen + (_chtTitleOY + ry) * _displayScreenWidth + _chtTitleOX;
+		for (uint16 rx = 0; rx < _chtTitleOW; rx++) {
+			if (src[rx] != 0xFF)
+				dst[rx] = src[rx];
+		}
+	}
+	copyDisplayRectToScreen(_chtTitleOX, _chtTitleOY, _chtTitleOW, _chtTitleOH);
+}
+
+// 用英文原文當 key 查中譯；查無則原樣返回
+const char *GfxMgr::getChtTranslation(const char *english) const {
+	if (!_chtEnabled || !_chtLangOn || !english)   // F8 切到英文時 _chtLangOn=false → 回原文
+		return english;
+	Common::HashMap<Common::String, Common::String>::const_iterator it = _chtTranslation.find(Common::String(english));
+	if (it != _chtTranslation.end())
+		return it->_value.c_str();
+	return english;
+}
+
+// 在文字格 (row,column) 畫一個 16x16 中文字
+void GfxMgr::drawBig5Character(int16 row, int16 column, uint16 big5, byte foreground, byte background) {
+	int16 x = column;
+	int16 y = row;
+	translateFontPosToDisplayScreen(x, y); // x=column*16, y=row*16（hi-res）
+	drawBig5CharacterOnDisplay(x, y, big5, foreground, background);
+}
+
+void GfxMgr::drawBig5CharacterOnDisplay(int16 x, int16 y, uint16 big5, byte foreground, byte background) {
+	if (!_chtFont)
+		return;
+	// 一律填滿整個字格再畫字（Big5Font 只畫前景 pixel，不碰背景 pixel）。
+	//
+	// 這裡曾經寫成「background 非 0 才填、0 視為透明」，那是錯的：引擎自己的 ASCII
+	// drawCharacterOnDisplay() 對整格每個 pixel 都上色（bit 設=foreground、bit 清=background），
+	// 沒有透明這回事。把 0 當透明會讓中文與同一行的 ASCII 行為不一致——
+	// 反白的選單列（foreground=15 白、background=0 黑）中文不填底，白字就畫在白色選單框上，
+	// 整個看不見（實測：檔案選單選取列只剩「〈F5〉」，「儲存」消失；選單列的 檔案/動作 被選中時同樣消失）。
+	for (int16 cy = 0; cy < 16; cy++) {
+		byte *rowPtr = _displayScreen + (y + cy) * _displayScreenWidth + x;
+		for (int16 cx = 0; cx < 16; cx++)
+			rowPtr[cx] = background;
+	}
+	byte *dest = _displayScreen + y * _displayScreenWidth + x;
+	_chtFont->drawBig5Char(dest, big5, 16, 16, _displayScreenWidth, foreground, background, false, 1);
+	copyDisplayRectToScreen(x, y, 16, 16); // 中文字固定 16x16（不用 _displayFontWidth，原生模式為 8）
+}
